# 此文件仅是字段说明。推荐执行 deploy.sh 自动生成真正的 .env 和随机密钥。
STUDIO_IMAGE=__IMAGE_REF__
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
DATA_DIR=__NAS_EXTERNAL_DISK_ABSOLUTE_PATH__
TZ=Asia/Shanghai
APP_ENV=staging
MEMORY_LIMIT=12g

MYSQL_DATABASE=amazon_ai_image_studio
MYSQL_USER=studio_app
MYSQL_ROOT_PASSWORD=__GENERATE_RANDOM_64_HEX__
MYSQL_PASSWORD=__GENERATE_RANDOM_64_HEX__
REDIS_PASSWORD=__GENERATE_RANDOM_64_HEX__
MINIO_ROOT_USER=studio_minio
MINIO_ROOT_PASSWORD=__GENERATE_RANDOM_64_HEX__
JWT_SIGNING_SECRET=__GENERATE_RANDOM_64_HEX__
API_KEY_ENCRYPTION_KEY=__GENERATE_RANDOM_64_HEX__
API_KEY_ENCRYPTION_KEY_ID=nas-v1

# 局域网 HTTP 默认值。通过 NAS HTTPS 反向代理公开时，请按 README 切换生产配置。
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=
AUTH_DEFAULT_TENANT_ID=

# 16 GB NAS 的保守并发默认值，可在确认内存余量后调整。
WORKER_CONCURRENCY=8
TASK_GLOBAL_CONCURRENCY=8
TASK_POLICY_MAX_CONCURRENCY=8
TASK_TENANT_CONCURRENCY=2
TASK_USER_CONCURRENCY=2
TASK_PROVIDER_CONCURRENCY=2
TASK_MODEL_CONCURRENCY=2
PROVIDER_TIMEOUT_SECONDS=600
PROVIDER_MAX_RETRIES=1
PROVIDER_MAX_RESPONSE_SIZE_MB=1024
PROVIDER_MAX_OUTPUT_IMAGE_SIZE_MB=512
