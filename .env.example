# Amazon AI Product Image Studio local environment template.
# Copy this file to .env for local development. Never commit .env.
#
# SECURITY: Every value containing "change-me" is a placeholder.
# Production, staging, and shared environments must replace JWT, cookie,
# database, Redis, MinIO, and API-key-encryption values with high-entropy
# environment-specific secrets.
#
# Do not add Provider API keys here. Provider keys must be managed through the
# backend admin APIs, encrypted at rest, and never exposed to the frontend.

COMPOSE_PROJECT_NAME=amazon-ai-product-image-studio
APP_ENV=local
LOG_LEVEL=info
TZ=UTC

# Local host bindings. Keep data stores private to the Compose network.
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8080
BACKEND_API_BIND_HOST=127.0.0.1
BACKEND_API_PORT=8081
BACKEND_HTTP_HOST=0.0.0.0
BACKEND_HTTP_PORT=8080
# Optional direct-backend override for BACKEND_HTTP_HOST and BACKEND_HTTP_PORT.
API_ADDR=
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=15s
API_SHUTDOWN_TIMEOUT=10s
WORKER_NAME=backend-worker
WORKER_SHUTDOWN_TIMEOUT=10s

# Build contexts and images.
FRONTEND_BUILD_CONTEXT=../frontend
FRONTEND_DOCKERFILE=Dockerfile
FRONTEND_NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
FRONTEND_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.29-alpine
BACKEND_BUILD_CONTEXT=../backend
BACKEND_DOCKERFILE=Dockerfile
BACKEND_API_BUILD_TARGET=api
BACKEND_WORKER_BUILD_TARGET=worker
BACKEND_GO_IMAGE=docker.m.daocloud.io/library/golang:1.25-alpine
BACKEND_ALPINE_IMAGE=docker.m.daocloud.io/library/alpine:3.22

# MySQL 8. Production must replace all passwords.
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
MYSQL_ROOT_PASSWORD=change-me-local-mysql-root-password
MYSQL_DATABASE=amazon_ai_image_studio
MYSQL_USER=studio_app
MYSQL_PASSWORD=change-me-local-mysql-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT=10s
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=30m

# Redis. Redis is not exposed on a host port by default.
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4-alpine
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-local-redis-password
REDIS_DB=0
REDIS_APPENDONLY=yes

# MinIO. MinIO API and console are not exposed on host ports by default.
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=docker.m.daocloud.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ROOT_USER=change-me-local-minio-access-key
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_ACCESS_KEY=change-me-local-minio-access-key
MINIO_SECRET_KEY=change-me-local-minio-password
MINIO_BUCKET_ORIGINALS=product-originals
MINIO_BUCKET_GENERATED=product-generated
MINIO_BUCKET_THUMBNAILS=product-thumbnails
MINIO_BROWSER=off

# JWT and cookie security. Production must replace the signing secret and use
# HTTPS-only cookies.
JWT_SIGNING_SECRET=change-me-at-least-32-bytes-prod-must-replace
JWT_ISSUER=amazon-ai-product-image-studio
JWT_ACCESS_TOKEN_TTL_MINUTES=60
AUTH_LOGIN_RATE_LIMIT_MAX_FAILURES=5
AUTH_LOGIN_RATE_LIMIT_WINDOW=10m
AUTH_COOKIE_NAME=studio_auth
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CSRF_ENABLED=true
CSRF_COOKIE_NAME=studio_csrf
# Fixed platform contract. Do not customize this header name.
CSRF_HEADER_NAME=X-CSRF-Token

# CORS. Keep this restricted to known frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# API key encryption. Production must replace the key with a high-entropy
# 32-byte base64 value. Populated environments currently have no in-place
# re-encryption workflow, so do not rotate this key or key ID in place.
API_KEY_ENCRYPTION_KEY=change-me-32-byte-base64-key-prod-must-replace
API_KEY_ENCRYPTION_KEY_ID=local-dev-v1

# Upload limits. SVG upload remains forbidden by contract.
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_MAX_WIDTH=8192
UPLOAD_MAX_HEIGHT=8192
UPLOAD_MAX_PIXELS=40000000
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Queue and worker controls.
TASK_QUEUE_NAME=image-tasks
WORKER_HEALTHCHECK_FILE=/tmp/worker-ready
# In-process task processing loop count for each Worker container. This is
# separate from TASK_* runtime concurrency limits below.
WORKER_CONCURRENCY=1
WORKER_RETENTION_MAINTENANCE_INTERVAL=1h
WORKER_RETENTION_MAINTENANCE_BATCH_LIMIT=100
MIGRATIONS_MODE=startup-gate
TASK_ENQUEUE_TIMEOUT=5s
TASK_CLAIM_TIMEOUT=5s
TASK_VISIBILITY_TIMEOUT=5m
TASK_RETRY_BACKOFF=5s
TASK_RECOVERY_INTERVAL=30s
TASK_CONCURRENCY_LEASE_TTL=10m
TASK_MAX_DELIVERIES=5
TASK_GLOBAL_CONCURRENCY=4
TASK_TENANT_CONCURRENCY=2
TASK_USER_CONCURRENCY=2
TASK_PROVIDER_CONCURRENCY=2
TASK_MODEL_CONCURRENCY=2

# Provider adapter defaults. Do not put Provider API keys in env files.
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2
